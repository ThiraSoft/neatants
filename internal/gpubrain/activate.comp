#version 450
// One workgroup thinks for one network: the nodes of a level are spread over
// the lanes, a barrier separates levels (a node only reads lower levels from
// this tick, see neat.Flat). It computes exactly what neat.Network.Activate
// computes; `precise` keeps the compiler from fusing the multiply-adds, so
// the results stay those of the CPU but for the division in fast_tanh.
//
// What limits the speed is how many networks are in flight, and that is
// decided by the shared memory a workgroup takes (the card has a fixed amount
// per compute unit). So the values live in MAX_VALUES floats only, see
// layout.go for how the previous tick's values fit in so few.

#ifndef LANES
#define LANES 64u
#endif
layout(local_size_x = LANES) in;
#include "neatmath.glsl"

layout(std430, binding = 0) buffer Arena { uint arena[]; };
layout(std430, binding = 1) readonly buffer Req { uint slots[]; };
layout(std430, binding = 2) readonly buffer In { float inputs[]; };
layout(std430, binding = 3) writeonly buffer Out { float outputs[]; };

layout(push_constant) uniform Push {
	uint count;
	uint inStride;
	uint outStride;
} pc;

#define HDR 8u
#define KIND_OFF HDR
#define ORDER_OFF (KIND_OFF + MAX_NODES)
#define LEVEL_OFF (ORDER_OFF + MAX_NODES)
#define OFF_OFF (LEVEL_OFF + MAX_NODES + 1u)
#define EDGE_OFF (OFF_OFF + 4u * MAX_NODES + 1u)
#define PL_OFF (EDGE_OFF + 2u * MAX_EDGES)
#define VALS_OFF (PL_OFF + 4u * MAX_PLASTIC)
#define CELL_OFF (VALS_OFF + MAX_NODES)
#define SLOT_WORDS (CELL_OFF + MAX_NODES)

// v[0, n) are the values of this tick. v[n, n+B) are the values of the
// previous tick that some edge reads (the back edges): a kind word carries,
// above its 8 kind bits, 1 + the place of its node's previous value in v.
shared float v[MAX_VALUES];

void main() {
	uint r = gl_WorkGroupID.x;
	if (r >= pc.count) return;
	if (slots[r] == 0xFFFFFFFFu) return;
	uint lane = gl_LocalInvocationID.x;
	uint base = slots[r] * SLOT_WORDS;
	uint n = arena[base + 0u];
	uint nLevels = arena[base + 2u];
	uint nPlastic = arena[base + 3u];
	uint inStart = arena[base + 4u], inEnd = arena[base + 5u];
	uint outStart = arena[base + 6u], outEnd = arena[base + 7u];

	// Values, inputs and the copies for the back edges, four loads in flight
	// per lane: the compiler waits for each load of a loop before the next
	// one, which is a trip to memory per node.
	for (uint i = lane; i < n; i += 4u * LANES) {
		float val[4], inp[4];
		uint kind[4];
		for (uint u = 0u; u < 4u; u++) {
			uint x = min(i + u * LANES, n - 1u);
			val[u] = uintBitsToFloat(arena[base + VALS_OFF + x]);
			kind[u] = arena[base + KIND_OFF + x];
			inp[u] = inputs[r * pc.inStride + (clamp(x, inStart, max(inEnd, 1u) - 1u) - inStart)];
		}
		for (uint u = 0u; u < 4u; u++) {
			uint x = i + u * LANES;
			if (x >= n) break;
			float y = val[u];
			if (x >= inStart && x < inEnd) y = inp[u];
			else if (x == 0u) y = 1.0;
			v[x] = y;
			if (kind[u] >> 8 != 0u) v[n + (kind[u] >> 8) - 1u] = y;
		}
	}
	barrier();

	for (uint l = 0u; l < nLevels; l++) {
		uint s = arena[base + LEVEL_OFF + l], e = arena[base + LEVEL_OFF + l + 1u];
		for (uint j = s + lane; j < e; j += LANES) {
			uint ni = arena[base + ORDER_OFF + j];
			uint gb = ni * 4u;
			bool mem = (arena[base + KIND_OFF + ni] & 0xFFu) == MEMORY;
			uint o0 = arena[base + OFF_OFF + gb], o1 = arena[base + OFF_OFF + gb + 1u];
			uint o2 = arena[base + OFF_OFF + gb + 2u], o3 = arena[base + OFF_OFF + gb + 3u];
			uint o4 = arena[base + OFF_OFF + gb + 4u];
			float cell = mem ? uintBitsToFloat(arena[base + CELL_OFF + ni]) : 0.0;
			// The edges of a node's four gates are contiguous, so one pass
			// over them serves all four sums: each chunk issues its loads
			// together instead of one dependent trip to memory per edge.
			// Each gate still adds its edges in order, as the CPU does.
			precise float s0 = 0.0, s1 = 0.0, s2 = 0.0, s3 = 0.0;
			uint end = mem ? o4 : o1;
			for (uint k = o0; k < end; k += 4u) {
				uint f[4];
				float w[4];
				for (uint t = 0u; t < 4u; t++) {
					// Past the end it re-reads the last edge, which is not
					// used, so the loads need no condition.
					uint at = base + EDGE_OFF + 2u * min(k + t, end - 1u);
					f[t] = arena[at];
					w[t] = uintBitsToFloat(arena[at + 1u]);
				}
				for (uint t = 0u; t < 4u; t++) {
					uint kk = k + t;
					if (kk >= end) break;
					precise float p = v[f[t]] * w[t];
					if (kk < o1) s0 = s0 + p;
					else if (kk < o2) s1 = s1 + p;
					else if (kk < o3) s2 = s2 + p;
					else s3 = s3 + p;
				}
			}
			if (!mem) {
				v[ni] = sig(s0);
			} else {
				precise float ig = sig01(s1 + 2.0);
				precise float fg = sig01(s2 + 2.0);
				precise float og = sig01(s3 + 2.0);
				precise float c = fg * cell + ig * fast_tanh(s0);
				arena[base + CELL_OFF + ni] = floatBitsToUint(c);
				precise float y = og * fast_tanh(c);
				v[ni] = y;
			}
		}
		barrier();
	}

	for (uint i = outStart + lane; i < outEnd; i += LANES) outputs[r * pc.outStride + (i - outStart)] = v[i];
	for (uint p = lane; p < nPlastic; p += LANES) {
		uint at = base + PL_OFF + 4u * p;
		uint k = arena[at];
		float pre = v[arena[at + 1u]], post = v[arena[at + 2u]];
		float eta = uintBitsToFloat(arena[at + 3u]);
		float w = uintBitsToFloat(arena[base + EDGE_OFF + 2u * k + 1u]);
		precise float nw = w + eta * post * (pre - post * w);
		arena[base + EDGE_OFF + 2u * k + 1u] = floatBitsToUint(clamp(nw, -8.0, 8.0));
	}
	for (uint i = lane; i < n; i += LANES) arena[base + VALS_OFF + i] = floatBitsToUint(v[i]);
}
