#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes : enable
// Same contract as xent.comp: bits[r] = -log2 softmax(s_g * E·o_r)[target_r]
// for 64 rows per workgroup, but the 64 x 64 block of logits of each column
// step comes out of the matrix cores. Each of the four waves owns 16 rows,
// keeps their 16 x DIM operand in registers for the whole vocabulary, and
// multiplies it by four 16-column blocks of the staged embedding. The result
// goes through shared memory so that four lanes a row can run the online max
// and sum, in base 2 so that the exponential is a single instruction.

#ifndef DIM
#define DIM 128
#endif
#define TR 64u
#define TC 64u
// One shared row is DIM halves seen as DIM/8 sixteen-byte words, plus one word
// so that the rows of a column-major load do not fall on the same banks.
#define RW (DIM / 8 + 1)
#define SW (TC + 4u)

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Gen { uint gw[]; };
layout(std430, binding = 1) readonly buffer Tokens { uint tokens[]; };
layout(std430, binding = 2) readonly buffer Emb { uvec4 emb[]; };   // halves, Vocab x Dim
layout(std430, binding = 3) readonly buffer Rows { uvec4 rows[]; }; // halves, R x Dim
layout(std430, binding = 4) writeonly buffer Bits { float bits[]; };

layout(push_constant) uniform Push {
	uint rows;
	uint vocab;
	uint dim;
	uint scored;
	uint windows;
	uint warm;
	uint startsOff;
	uint scaleOff;
} pc;

shared uvec4 As[TR * RW];
shared uvec4 Bs[TC * RW];
shared float Ss[TR * SW];

const float LOG2E = 1.44269504088896340736;

void main() {
	uint tid = gl_LocalInvocationID.x;
	uint wave = gl_SubgroupID;
	uint r0 = gl_WorkGroupID.x * TR;
	uint r = tid >> 2, part = tid & 3u;
	uint wv = DIM / 8;

	// The row of this lane, and its scale folded with log2(e).
	uint rr = min(r0 + r, pc.rows - 1u);
	uint p = rr / pc.scored;
	uint g = p / pc.windows, w = p % pc.windows;
	uint t = pc.warm + rr % pc.scored;
	float scale = uintBitsToFloat(gw[pc.scaleOff + g]) * LOG2E;
	uint target = tokens[gw[pc.startsOff + w] + t + 1u];
	float m = -1e30, s = 0.0, tg = -1e30;

	for (uint q = tid; q < TR * wv; q += 256u) {
		uint row = q / wv, kk = q % wv;
		As[row * RW + kk] = rows[min(r0 + row, pc.rows - 1u) * wv + kk];
	}
	barrier();
	coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a[DIM / 16];
	[[unroll]] for (uint k = 0u; k < DIM / 16; k++)
		coopMatLoad(a[k], As, wave * 16u * RW + 2u * k, RW, gl_CooperativeMatrixLayoutRowMajor);

	for (uint c0 = 0u; c0 < pc.vocab; c0 += TC) {
		barrier();
		for (uint q = tid; q < TC * wv; q += 256u) {
			uint row = q / wv, kk = q % wv;
			Bs[row * RW + kk] = emb[min(c0 + row, pc.vocab - 1u) * wv + kk];
		}
		barrier();
		[[unroll]] for (uint j = 0u; j < 4u; j++) {
			coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc =
				coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
			[[unroll]] for (uint k = 0u; k < DIM / 16; k++) {
				coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
				coopMatLoad(b, Bs, j * 16u * RW + 2u * k, RW, gl_CooperativeMatrixLayoutColumnMajor);
				acc = coopMatMulAdd(a[k], b, acc);
			}
			coopMatStore(acc, Ss, wave * 16u * SW + j * 16u, SW, gl_CooperativeMatrixLayoutRowMajor);
		}
		barrier();
		float x[16];
		float tm = m;
		[[unroll]] for (uint c = 0u; c < 16u; c++) {
			uint col = c0 + part * 16u + c;
			x[c] = col < pc.vocab ? Ss[r * SW + part * 16u + c] * scale : -1e30;
			if (col == target) tg = x[c];
			tm = max(tm, x[c]);
		}
		s *= exp2(m - tm);
		[[unroll]] for (uint c = 0u; c < 16u; c++) s += exp2(x[c] - tm);
		m = tm;
	}

	barrier();
	// Merge the four lanes of a row; they are consecutive lanes of one wave.
	float M = m, T = tg;
	for (uint o = 1u; o < 4u; o <<= 1u) {
		uint other = tid ^ o;
		// Shared memory stands in for a subgroup shuffle, to stay inside
		// the extensions the device asks for.
		Ss[tid] = M;
		Ss[256u + tid] = T;
		Ss[512u + tid] = s;
		barrier();
		float M2 = Ss[other], T2 = Ss[256u + other], s2 = Ss[512u + other];
		barrier();
		float Mn = max(M, M2);
		s = s * exp2(M - Mn) + s2 * exp2(M2 - Mn);
		M = Mn;
		T = max(T, T2);
	}
	if (part == 0u && r0 + r < pc.rows) bits[r0 + r] = M + log2(s) - T;
}
