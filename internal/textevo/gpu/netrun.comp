#version 450
// One workgroup runs one (genome, window) pair over the whole window: the
// state of the network (values, LSTM cells, plastic weights) stays in shared
// memory from the first tick to the last, so a generation is one dispatch and
// the only global writes are the output vectors of the scored ticks. Each
// tick computes exactly what neat.Flat.Activate computes.
//
// Grown networks are deep and narrow (the champions of the first runs have
// about eighty levels of two to ten nodes), so a level is done in two steps:
// every lane takes one edge of the level and stores its product, then every
// lane takes one node and adds up the products of its edges in the order of
// the CPU. The long serial walk over a node's edges in global memory becomes
// one load per lane and a short walk in shared memory.
//
// What limits the speed is how many workgroups are in flight, which the
// shared memory a workgroup takes decides, so the capacities are kept small
// (see pack.go) and a workgroup is a single wave, for which a barrier is
// almost free.

#ifndef LANES
#define LANES 64u
#endif
layout(local_size_x = LANES) in;

#include "neatmath.glsl"
#extension GL_KHR_shader_subgroup_basic : require

#ifdef SGBAR
#define BAR() { subgroupMemoryBarrierShared(); subgroupBarrier(); }
#else
#define BAR() barrier()
#endif

// gen: [starts K][scale G][goff G][records], see pack.go.
layout(std430, binding = 0) readonly buffer Gen { uint gw[]; };
layout(std430, binding = 1) readonly buffer Tokens { uint tokens[]; };
layout(std430, binding = 2) readonly buffer Emb { float emb[]; };
layout(std430, binding = 3) writeonly buffer Rows { uint rows[]; }; // two halves per word

layout(push_constant) uniform Push {
	uint pairs;
	uint windows;
	uint len;
	uint warm;
	uint dim;
	uint startsOff;
	uint goffOff;
	uint listOff;
} pc;

#define MAX_BANKS 4u
// DECAY is model.Decays.
const float DECAY[MAX_BANKS] = float[MAX_BANKS](0.5, 0.875, 0.97, 0.992);

// The state banks of model.Net live in v, in the values of their input
// nodes: an input is written only by the tick that reads it, so a bank input
// keeps its value from one tick to the next, which is all a bank needs. They
// take no shared memory beyond the values the network already has.
shared float v[MAX_VALUES];
shared float cell[MAX_MEMORY];
shared float pw[MAX_PLASTIC];
shared float prod[LEVEL_EDGES];

#ifndef SUMW
#define SUMW 4u
#endif
// sumProd adds prod[a..b) in order, as the CPU does, but reads SUMW products
// at once: a read of shared memory takes many cycles, and one at a time they
// would follow each other.
float sumProd(uint a, uint b) {
	precise float s = 0.0;
	uint k = a;
	for (; k + SUMW <= b; k += SUMW) {
		float x[SUMW];
		for (uint u = 0u; u < SUMW; u++) x[u] = prod[k + u];
		for (uint u = 0u; u < SUMW; u++) s = s + x[u];
	}
	for (; k < b; k++) s = s + prod[k];
	return s;
}

// Pre holds what a lane loads ahead for a level: its first edge and the
// order word and gate offsets of its first node.
struct Pre {
	uint fw, wb, ow, o4;
	uvec4 of;
};

// fetch loads them whether the lane has an edge or a node in the level or
// not, at a clamped index: a load under a branch would leave the compiler
// unsure how many loads are in flight, and it would then wait for all of them
// before the first use, the prefetched ones included.
Pre fetch(uvec4 lb, uint lane, uint lastE, uint lastJ, uint edgeOff, uint orderOff, uint offOff) {
	uint k = min(lb.y + lane, lastE), j = min(lb.x + lane, lastJ);
	uint gb = offOff + 4u * j;
	return Pre(gw[edgeOff + 2u * k], gw[edgeOff + 2u * k + 1u], gw[orderOff + j], gw[gb + 4u],
		uvec4(gw[gb], gw[gb + 1u], gw[gb + 2u], gw[gb + 3u]));
}

// edge stores the product of one edge, k counted from the first of its level.
void edge(uint k, uint fw, uint wb) {
	uint pl = (fw >> 16) & 0x7FFFu;
	float wt = pl != 0u ? pw[pl - 1u] : uintBitsToFloat(wb);
	precise float x = v[fw & 0xFFFFu] * wt;
	prod[k] = x;
}

// node computes one node from the products of its level, its offsets
// counted from the first edge of the level.
void node(uint ow, uvec4 of, uint o4) {
	uint ni = ow & 0xFFFFu;
	float s0 = sumProd(of.x, of.y);
	if ((ow & 0x80000000u) == 0u) {
		v[ni] = sig(s0);
	} else {
		float s1 = sumProd(of.y, of.z), s2 = sumProd(of.z, of.w), s3 = sumProd(of.w, o4);
		uint ci = (ow >> 16) & 0x7FFFu;
		precise float ig = sig01(s1 + 2.0);
		precise float fg = sig01(s2 + 2.0);
		precise float og = sig01(s3 + 2.0);
		precise float c = fg * cell[ci] + ig * fast_tanh(s0);
		cell[ci] = c;
		precise float y = og * fast_tanh(c);
		v[ni] = y;
	}
}

void main() {
	if (gl_WorkGroupID.x >= pc.pairs) return;
	// The pairs of this variant are listed, see layoutInto.
	uint p = gw[pc.listOff + gl_WorkGroupID.x];
	uint lane = gl_LocalInvocationID.x;
	uint g = p / pc.windows, w = p % pc.windows;
	uint b = gw[pc.goffOff + g];
	uint n = gw[b], nOrder = gw[b + 1u], nLevels = gw[b + 2u], nPlastic = gw[b + 3u];
	uint inStart = gw[b + 4u], inEnd = gw[b + 5u], outStart = gw[b + 6u];
	uint kindOff = b + 8u;
	uint levelOff = kindOff + n;
	uint orderOff = levelOff + 2u * (nLevels + 1u);
	uint offOff = orderOff + nOrder;
	uint nEdges = gw[offOff + 4u * nOrder];
	uint edgeOff = offOff + 4u * nOrder + 1u;
	uint plOff = edgeOff + 2u * nEdges;
	uint lastE = max(nEdges, 1u) - 1u, lastJ = max(nOrder, 1u) - 1u;
	uint start = gw[pc.startsOff + w];
	uint scored = pc.len - pc.warm;
	uint hd = pc.dim / 2u;
	// The state banks are inputs after the embedding (see model.Shape), so
	// the record says how many a network has.
	uint banks = (inEnd - inStart) / pc.dim - 1u;

	for (uint i = lane; i < n; i += LANES) v[i] = 0.0;
	for (uint i = lane; i < MAX_MEMORY; i += LANES) cell[i] = 0.0;
	for (uint q = lane; q < nPlastic; q += LANES) pw[q] = uintBitsToFloat(gw[edgeOff + 2u * gw[plOff + 4u * q] + 1u]);
	BAR();

	for (uint t = 0u; t < pc.len; t++) {
		uint row = tokens[start + t] * pc.dim;
		// The write rate of each bank, from the gate the network wrote at the
		// tick before; nothing has written a gate before the first tick, which
		// then has the default rate, as model.Net does.
		float rate[MAX_BANKS];
		for (uint b = 0u; b < MAX_BANKS; b++) {
			float gt = 0.5;
			if (t > 0u && b < banks) gt = v[outStart + pc.dim + b];
			precise float r = (1.0 - DECAY[b]) * 2.0 * gt;
			rate[b] = r;
		}
		// Bias and inputs, then the previous-tick copies, as Flat.Activate
		// sets the inputs before it copies the values. Only the bias and the
		// inputs are written, so that the gates read above are never written
		// while other lanes read them.
		for (uint x = lane; x < n; x += LANES) {
			float y = v[x];
			if (x == 0u) {
				y = 1.0;
				v[x] = y;
			} else if (x >= inStart && x < inEnd) {
				uint k = x - inStart;
				if (k < pc.dim) {
					y = emb[row + k];
				} else {
					// A bank input keeps its bank value from tick to tick
					// and moves towards the embedding, as model.StepState.
					k -= pc.dim;
					precise float s = y + rate[k / pc.dim] * (emb[row + k % pc.dim] - y);
					y = s;
				}
				v[x] = y;
			}
			uint back = gw[kindOff + x] >> 8;
			if (back != 0u) v[n + back - 1u] = y;
		}
		BAR();

		// The loads of a level do not depend on any product, so those of the
		// first edge and the first node of each lane are asked for one level
		// ahead, and arrive while the level before is being computed.
		uvec4 lb = uvec4(gw[levelOff], gw[levelOff + 1u], gw[levelOff + 2u], gw[levelOff + 3u]);
		uvec4 lbn = uvec4(0u);
		if (nLevels > 1u) lbn = uvec4(lb.z, lb.w, gw[levelOff + 4u], gw[levelOff + 5u]);
#ifdef NOLEVEL
		nLevels = 0u;
#endif
		Pre cur = fetch(lb, lane, lastE, lastJ, edgeOff, orderOff, offOff);
		for (uint l = 0u; l < nLevels; l++) {
			Pre nxt = fetch(lbn, lane, lastE, lastJ, edgeOff, orderOff, offOff);
			uvec4 lbnn = uvec4(0u);
			if (l + 2u < nLevels) lbnn = uvec4(lbn.z, lbn.w, gw[levelOff + 2u * (l + 3u)], gw[levelOff + 2u * (l + 3u) + 1u]);
			uint s = lb.x, es = lb.y, e = lb.z, ee = lb.w;
			// Most levels have fewer edges and nodes than lanes, and then
			// the prefetched ones are all there is; the others load the
			// rest on the spot.
			if (es + lane < ee) edge(lane, cur.fw, cur.wb);
			if (ee - es > LANES) {
				for (uint k = es + lane + LANES; k < ee; k += LANES) edge(k - es, gw[edgeOff + 2u * k], gw[edgeOff + 2u * k + 1u]);
			}
			BAR();
			if (s + lane < e) node(cur.ow, cur.of - es, cur.o4 - es);
			if (e - s > LANES) {
				for (uint j = s + lane + LANES; j < e; j += LANES) {
					uint gb = offOff + 4u * j;
					node(gw[orderOff + j], uvec4(gw[gb], gw[gb + 1u], gw[gb + 2u], gw[gb + 3u]) - es, gw[gb + 4u] - es);
				}
			}
			BAR();
			lb = lbn;
			lbn = lbnn;
			cur = nxt;
		}

		if (t >= pc.warm) {
			uint r = (p * scored + (t - pc.warm)) * hd;
			for (uint j = lane; j < hd; j += LANES) {
				uint o = outStart + 2u * j;
				rows[r + j] = packHalf2x16(vec2(2.0 * v[o] - 1.0, 2.0 * v[o + 1u] - 1.0));
			}
		}
		for (uint q = lane; q < nPlastic; q += LANES) {
			uint at = plOff + 4u * q;
			float pre = v[gw[at + 1u]], post = v[gw[at + 2u]];
			float eta = uintBitsToFloat(gw[at + 3u]);
			float wq = pw[q];
			precise float nw = wq + eta * post * (pre - post * wq);
			pw[q] = clamp(nw, -8.0, 8.0);
		}
		BAR();
	}
}
